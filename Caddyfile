# Public edge domain -> internal Gateway hostnames
#
# Caddy runs outside the cluster and forwards traffic to the Kubernetes Gateway.
# Prefer NodePort targets to avoid VIP reachability issues after reboots.
# Gateway NodePort: 32211 (service cilium-gateway-web-gateway)
# Node IPs: 10.19.87.10, 10.19.87.11, 10.19.87.12, 10.19.87.14, 10.19.87.15
#
# External domain: *.hse-llm-project-2026.ru
# Internal Gateway hostnames: *.hse-llm.internal

{
    # Optional contact email for ACME issuers
    # email you@example.com
}

# Frontend
frontend.hse-llm-project-2026.ru {
    reverse_proxy 10.19.87.10:32211 10.19.87.11:32211 10.19.87.12:32211 10.19.87.14:32211 10.19.87.15:32211 {
        header_up Host frontend.hse-llm.internal
    }
}

# Deployment API
deployment.hse-llm-project-2026.ru {
    reverse_proxy 10.19.87.10:32211 10.19.87.11:32211 10.19.87.12:32211 10.19.87.14:32211 10.19.87.15:32211 {
        header_up Host deployment.hse-llm.internal
    }
}

# Security/Audit API
audit.hse-llm-project-2026.ru {
    reverse_proxy 10.19.87.10:32211 10.19.87.11:32211 10.19.87.12:32211 10.19.87.14:32211 10.19.87.15:32211 {
        header_up Host audit.hse-llm.internal
    }
}

# Grafana
grafana.hse-llm-project-2026.ru {
    reverse_proxy 10.19.87.10:32211 10.19.87.11:32211 10.19.87.12:32211 10.19.87.14:32211 10.19.87.15:32211 {
        header_up Host grafana.hse-llm.internal
        # Grafana CSRF check compares Origin with backend-visible host.
        # We rewrite Origin/Referer to the same internal host as Host header.
        header_up Origin https://grafana.hse-llm.internal
        header_up Referer https://grafana.hse-llm.internal
    }
}

